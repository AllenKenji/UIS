# Firebase
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# Use one of the two credential strategies below.
# Strategy A (recommended on Render): JSON string stored as secret.
FIREBASE_SERVICE_ACCOUNT=

# Strategy B (local only): path to a local service account key file.
GOOGLE_APPLICATION_CREDENTIALS=backend/serviceAccountKey.json

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
